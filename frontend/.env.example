# FactoryPulse Frontend Environment Configuration Template
# Copy this file to .env and configure as needed

# Backend API Base URL
VITE_API_BASE_URL=/api/v1

# Application Branding
VITE_APP_NAME=FactoryPulse
VITE_APP_DESCRIPTION=Industrial Machine Downtime Intelligence & Production Loss Estimator

# Default Plant Facility Site
VITE_DEFAULT_PLANT_CODE=PLANT_01

# Feature Toggles
VITE_ENABLE_ANALYTICS_DEBUG=false
